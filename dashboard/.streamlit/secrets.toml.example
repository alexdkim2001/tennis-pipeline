# Copy this file to .streamlit/secrets.toml and fill in real values.
# secrets.toml is gitignored - never commit actual credentials.
#
# DATABRICKS_HOST is just the hostname, no scheme (e.g. dbc-xxxx.cloud.databricks.com)
# DATABRICKS_HTTP_PATH comes from the SQL warehouse's Connection details tab.
# DATABRICKS_TOKEN is a personal access token (Settings -> Developer -> Access tokens).

DATABRICKS_HOST = "dbc-xxxxxxxx-xxxx.cloud.databricks.com"
DATABRICKS_HTTP_PATH = "/sql/1.0/warehouses/xxxxxxxxxxxxxxxx"
DATABRICKS_TOKEN = "dapi_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
